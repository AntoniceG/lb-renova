# URL publique du site (sans slash final). Sert à metadataBase, canonical, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "production" uniquement au lancement :
#  - indexation autorisée (robots)
#  - le build ÉCHOUE s'il reste une constante TODO_ dans src/config/site.config.ts
# Toute autre valeur (ou absence) = site non indexable (previews, dev).
SITE_ENV=development
