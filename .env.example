# URL publique du site (sans slash final). Sert à metadataBase, canonical, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "production" uniquement au lancement :
#  - indexation autorisée (robots)
#  - le build ÉCHOUE s'il reste une constante TODO_ dans src/config/site.config.ts
# Toute autre valeur (ou absence) = site non indexable (previews, dev).
SITE_ENV=development

# --- Phase 5 : leads (à renseigner quand les comptes existent ; ne jamais commiter de vraies valeurs) ---
# Supabase (projet dédié LB Rénova)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-robot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (emails transactionnels) ; l'expéditeur doit appartenir au domaine vérifié
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Adresse qui reçoit la notification interne de chaque nouveau lead
LEADS_NOTIFICATION_EMAIL=

# n8n : URL du webhook et secret de signature HMAC
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
